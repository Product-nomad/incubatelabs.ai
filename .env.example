# Plausible analytics — created at https://plausible.io
# Set to your domain. The site auto-skips analytics if unset.
PUBLIC_PLAUSIBLE_DOMAIN=incubatelabs.ai

# Cloudflare Turnstile site key (public). Without it, production builds omit
# the widget and the form endpoint rejects submissions.
PUBLIC_TURNSTILE_SITE_KEY=
