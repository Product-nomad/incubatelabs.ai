---
import Layout from "@/layouts/Layout.astro";
import UseCaseCard from "@/components/UseCaseCard.astro";
import WorkCard from "@/components/WorkCard.astro";
import CallToAction from "@/components/CallToAction.astro";
import { useCases } from "@/data/useCases";
import { work } from "@/data/work";

const audiences = [
  {
    title: "No IT team",
    body: "You run the business, and the technology is whoever's least busy. You want things that work without someone babysitting them.",
  },
  {
    title: "An IT provider who fixes laptops",
    body: "Your provider keeps email, devices and backups running. That's valuable, but it isn't the same as improving how work gets done.",
  },
  {
    title: "On the brink of a hire",
    body: "The team is stretched and you're about to recruit. Taking the repetitive work away first could buy you months before you need to.",
  },
];

const tiers = [
  {
    name: "Quick Win",
    body: "One task, one fix. A small, fast piece of work that proves whether AI earns its place in your business.",
  },
  {
    name: "Automation Sprint",
    body: "One workflow automated end to end, with a fixed scope and a clear result. This is where most clients start.",
  },
  {
    name: "Operations Uplift",
    body: "Several connected workflows across the business, planned and delivered together.",
  },
];

const portfolio = work.filter((item) => item.external);
---

<Layout
  title="Incubate Labs | Practical AI for small businesses"
  description="Practical AI and automation for UK small businesses without an IT team. Take repetitive admin off your team's plate and put off the next hire. Based in Cambridgeshire."
>
  <!-- Hero -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16 pb-20 sm:pt-24">
    <p class="text-sm font-medium text-accent">AI and automation for UK small businesses</p>
    <h1 class="mt-4 max-w-4xl text-4xl sm:text-6xl leading-tight">Do more with the team you already have.</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">
      We take the repetitive admin off your people's plates: the reading, re-typing, chasing and reporting. That means they can get on with the work that grows the business. It's not about replacing anyone. It's about not needing to hire again quite so soon.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/contact/" class="bg-ink text-paper rounded-md px-6 py-3 font-medium transition-colors hover:bg-accent">Talk it through</a>
      <a href="/use-cases/" class="border border-ink text-ink rounded-md px-6 py-3 font-medium transition-colors hover:bg-ink hover:text-paper">See what we automate</a>
    </div>
  </section>

  <!-- Who we work with -->
  <section class="bg-band border-y border-line">
    <div class="max-w-page mx-auto px-4 sm:px-6 py-16">
      <h2 class="text-3xl sm:text-4xl">Who we work with</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {audiences.map((a) => (
          <div>
            <h3 class="text-xl">{a.title}</h3>
            <p class="mt-2 text-muted">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Six jobs -->
  <section class="max-w-page mx-auto px-4 sm:px-6 py-20">
    <h2 class="text-3xl sm:text-4xl">Six jobs we take off your plate</h2>
    <p class="mt-4 max-w-prose text-lg text-muted">
      These are the places we most often find hours going missing in a small business. If one of them sounds familiar, that's usually the place to start.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {useCases.map((uc, i) => <UseCaseCard useCase={uc} index={i} />)}
    </div>
  </section>

  <!-- Not everything needs AI -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pb-20">
    <div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[1fr_2fr]">
      <h2 class="text-3xl sm:text-4xl">Not everything needs AI.</h2>
      <div class="max-w-prose space-y-4 text-lg text-muted">
        <p>A surprising number of "AI problems" are really a missing integration, a messy spreadsheet or a process nobody wrote down. When that's the case, we'll say so and fix it the simple way. It's cheaper for you and it's more reliable.</p>
        <p>When AI is the right tool, we build it with a person in the loop where it matters, on systems you already use, and we hand it over so you're not dependent on us.</p>
      </div>
    </div>
  </section>

  <!-- Engagement sizes -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pb-20">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-3xl sm:text-4xl">Fixed scope. Agreed up front.</h2>
        <p class="mt-4 max-w-prose text-lg text-muted">
          Three sizes of engagement, all with a fixed scope and a fixed price agreed before any work starts. No open-ended day rates.
        </p>
      </div>
      <a href="/how-we-work/" class="shrink-0 font-medium text-accent hover:underline">How we work →</a>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {tiers.map((t) => (
        <div class="border border-line rounded-xl p-6">
          <h3 class="text-xl">{t.name}</h3>
          <p class="mt-2 text-muted">{t.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-muted">Need a website too? We build those as well, either alongside an automation project or on their own.</p>
  </section>

  <!-- Who you'll work with -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pb-20">
    <div class="grid gap-6 border border-line rounded-xl p-6 sm:p-10 md:grid-cols-[1fr_2fr]">
      <h2 class="text-2xl sm:text-3xl">Who you'll work with</h2>
      <div class="max-w-prose space-y-4 text-lg text-muted">
        <p>Incubate Labs is run by Simon Newton from Cambridgeshire. Before this, Simon spent years delivering operations and technology programmes, most recently as a Lead Product Delivery Manager at Ocado, after earlier careers in the British Army and in post-conflict reconstruction.</p>
        <p>You deal with the person doing the work, from the first call to the handover. <a href="/about/" class="font-medium text-accent hover:underline">More about Simon →</a></p>
      </div>
    </div>
  </section>

  <!-- Things I've built -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pb-20">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl sm:text-4xl">Things I've built</h2>
      <a href="/work/" class="shrink-0 font-medium text-accent hover:underline">See all →</a>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {portfolio.map((item) => <WorkCard item={item} />)}
    </div>
  </section>

  <!-- Readiness Check band -->
  <section class="bg-accent-soft">
    <div class="max-w-page mx-auto px-4 sm:px-6 py-16 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-prose">
        <h2 class="text-3xl sm:text-4xl">Not ready to talk yet?</h2>
        <p class="mt-4 text-lg text-muted">Take the free Readiness Check. A few minutes of questions about how work happens in your business, and you'll see which jobs are worth automating first. No email needed.</p>
      </div>
      <a href="/readiness-check/" class="shrink-0 self-start md:self-center bg-ink text-paper rounded-md px-6 py-3 font-medium transition-colors hover:bg-accent">Take the Readiness Check →</a>
    </div>
  </section>

  <CallToAction />
</Layout>
