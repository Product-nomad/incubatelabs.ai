---
import Layout from "@/layouts/Layout.astro";
import LostDayHero from "@/components/LostDayHero.astro";
import Hexagon from "@/components/Hexagon.astro";
import UseCaseCard from "@/components/UseCaseCard.astro";
import WebsiteCard from "@/components/WebsiteCard.astro";
import CostCheck from "@/components/CostCheck.astro";
import EngagementCard from "@/components/EngagementCard.astro";
import WorkCard from "@/components/WorkCard.astro";
import CallToAction from "@/components/CallToAction.astro";
import { useCases } from "@/data/useCases";
import { engagements } from "@/data/engagements";
import { work } from "@/data/work";
import { site } from "@/data/site";

const familiar = [
  "Evenings and weekends go on admin you'd love to hand off",
  "You're about to hire someone mainly to keep up with paperwork",
  "The same details get typed into three different systems",
  "Your team already uses ChatGPT, on personal accounts, with no rules",
  "You know AI could help, but not where, or what it would pay back",
  "Quotes and replies wait until the one person who knows has time",
];

const askedFor = [
  { asked: "An AI chatbot for customers", fix: "A set of good saved replies" },
  { asked: "AI to move data between systems", fix: "A direct link between the two" },
  { asked: "AI to work out what to charge", fix: "Clear pricing rules you can check" },
  { asked: "AI to read documents that always look the same", fix: "A simple template rule" },
];

const projects = work.filter((item) => !item.workPageOnly);

// Same structure as the Service entries on the use-case pages.
const websiteService = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Small business website design",
  serviceType: "Small business website design",
  description:
    "Fast, clear websites for UK small businesses, built on their own or alongside an automation project and connected to the systems behind them.",
  provider: { "@id": `${site.url}/#org` },
  areaServed: { "@type": "Country", name: "United Kingdom" },
  url: `${site.url}/`,
};
---

<Layout
  title="AI Consultant for UK Small Businesses | Incubate Labs"
  description="Practical AI and automation for UK small businesses. Fixed-price projects that take the repetitive admin off your team."
  socialDescription="Practical AI and automation for UK small businesses. Fixed-price projects that take the repetitive admin off your team."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(websiteService)} />
  <LostDayHero />

  <!-- Sound familiar? -->
  <section class="bg-band border-y border-line">
    <div class="max-w-page mx-auto px-4 sm:px-6 py-16 grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <h2 class="text-3xl sm:text-4xl">Sound familiar?</h2>
        <p class="mt-4 text-lg text-muted">For owner-run UK businesses of 5 to 50 people. We handle the technical side; you keep running the business.</p>
        <a href="/contact/" class="mt-6 inline-block font-medium text-accent hover:underline">If three or more ring true, let's talk →</a>
      </div>
      <ul class="familiar-grid">
        {familiar.map((item) => (
          <li class="flex items-start gap-3 bg-paper border border-line rounded-xl px-5 py-[18px] text-[17px]">
            <Hexagon />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Where we can help -->
  <section class="max-w-page mx-auto px-4 sm:px-6 py-20">
    <h2 class="text-3xl sm:text-4xl">Where we can help</h2>
    <p class="mt-4 max-w-prose text-lg text-muted">
      Most work starts with the admin that eats your team's week. Sometimes it starts with the website that should be bringing work in. We build both, and connect them.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {useCases.map((uc, i) => <UseCaseCard useCase={uc} index={i} />)}
      <WebsiteCard />
    </div>
  </section>

  <!-- Not everything needs AI -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pb-20">
    <div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[1fr_2fr]">
      <h2 class="text-3xl sm:text-4xl">Not everything needs AI.</h2>
      <div>
        <p class="max-w-prose text-lg text-muted">A surprising number of "AI problems" are really a missing integration, a messy spreadsheet or a process nobody wrote down. When that's the case, we'll say so and fix it the simple way. It's cheaper for you and it's more reliable.</p>
        <div class="mt-8">
          <div class="hidden sm:grid grid-cols-[1fr_auto_1fr] gap-4 px-5 pb-2 text-sm font-medium text-muted" aria-hidden="true">
            <span>What gets asked for</span>
            <span class="w-5"></span>
            <span>What often fixes it</span>
          </div>
          <ul class="space-y-3">
            {askedFor.map((row) => (
              <li class="grid gap-2 border border-line rounded-xl px-5 py-4 sm:grid-cols-[1fr_auto_1fr] sm:items-center sm:gap-4">
                <span class="text-muted line-through decoration-muted/60"><span class="sr-only">Asked for: </span>{row.asked}</span>
                <span class="font-semibold text-accent" aria-hidden="true">→</span>
                <span class="font-medium text-ink"><span class="sr-only">Often fixed by: </span>{row.fix}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CostCheck />

  <!-- Engagement sizes -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pb-20">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-3xl sm:text-4xl">Fixed scope. Agreed up front.</h2>
        <p class="mt-4 max-w-prose text-lg text-muted">
          Three sizes of engagement, all with a fixed scope and a fixed price agreed before any work starts. No open-ended day rates.
        </p>
      </div>
      <a href="/how-we-work/" class="shrink-0 font-medium text-accent hover:underline">How we work →</a>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {engagements.map((e) => <EngagementCard engagement={e} />)}
    </div>
  </section>

  <!-- Who you'll work with -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pb-20">
    <div class="grid gap-6 border border-line rounded-xl p-6 sm:p-10 md:grid-cols-[1fr_2fr]">
      <h2 class="text-2xl sm:text-3xl">Hands-on from the first call to the handover.</h2>
      <div class="max-w-prose space-y-4 text-lg text-muted">
        <p>Incubate Labs is run by Simon Newton. Before this, Simon spent years delivering operations and technology programmes, most recently as a Lead Product Delivery Manager at Ocado, after an earlier career in the British Army.</p>
        <p><a href="/about/" class="font-medium text-accent hover:underline">More about Simon →</a></p>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="max-w-page mx-auto px-4 sm:px-6 pb-20">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl sm:text-4xl">Projects</h2>
      <a href="/work/" class="shrink-0 font-medium text-accent hover:underline">See all →</a>
    </div>
    <p class="mt-4 max-w-prose text-lg text-muted">Real, working builds: tools in use today and proofs of concept that tested an idea properly.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {projects.map((item) => <WorkCard item={item} />)}
    </div>
  </section>

  <!-- Readiness Check band -->
  <section class="bg-accent-soft">
    <div class="max-w-page mx-auto px-4 sm:px-6 py-16 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-prose">
        <h2 class="text-3xl sm:text-4xl">Not ready to talk yet?</h2>
        <p class="mt-4 text-lg text-muted">Take the free Readiness Check. A few minutes of questions about how work happens in your business, and you'll see which jobs are worth automating first. No email needed.</p>
      </div>
      <a href="/readiness-check/" class="shrink-0 self-start md:self-center bg-ink text-paper rounded-md px-6 py-3 font-medium transition-colors hover:bg-accent">Take the Readiness Check →</a>
    </div>
  </section>

  <CallToAction />
</Layout>

<style>
  .familiar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 12px;
  }
</style>
