---
import Layout from "@/layouts/Layout.astro";
import WorkCard from "@/components/WorkCard.astro";
import CallToAction from "@/components/CallToAction.astro";
import { work } from "@/data/work";
---

<Layout
  title="Projects | Incubate Labs"
  description="Real, working AI builds: an agentic compliance pipeline, a local tool that strips personal data, a secret-leak agent and a retail AI proof of concept."
>
  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16 pb-12">
    <p class="text-sm font-medium text-accent">Projects</p>
    <h1 class="mt-4 max-w-4xl text-4xl sm:text-5xl leading-tight">Projects</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">
      Real, working builds: tools in use today and proofs of concept that tested an idea properly.
    </p>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {work.map((item) => <WorkCard item={item} headingLevel="h2" />)}
    </div>
  </section>

  <CallToAction />
</Layout>
