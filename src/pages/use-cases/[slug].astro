---
import Layout from "@/layouts/Layout.astro";
import CallToAction from "@/components/CallToAction.astro";
import { illustrations } from "@/components/illustrations";
import { useCases, type UseCase } from "@/data/useCases";
import { site } from "@/data/site";

export function getStaticPaths() {
  return useCases.map((useCase) => ({ params: { slug: useCase.slug }, props: { useCase } }));
}

interface Props {
  useCase: UseCase;
}

const { useCase } = Astro.props;
const others = useCases.filter((uc) => uc.slug !== useCase.slug);
const Illustration = illustrations[useCase.slug];
const url = `${site.url}/use-cases/${useCase.slug}/`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: useCase.title,
    serviceType: useCase.seoTitle,
    description: useCase.seoDescription,
    provider: { "@id": `${site.url}/#org` },
    areaServed: { "@type": "Country", name: "United Kingdom" },
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Where we can help", item: `${site.url}/use-cases/` },
      { "@type": "ListItem", position: 3, name: useCase.title, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: useCase.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title={`${useCase.seoTitle} | Incubate Labs`} description={useCase.seoDescription}>
  {structuredData.map((data) => (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(data)} />
  ))}

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-12 pb-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/use-cases/" class="hover:text-accent">Where we can help</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span aria-current="page" class="text-ink">{useCase.title}</span>
    </nav>
    <div class="mt-6 flex max-w-xl items-center justify-center bg-band border border-line rounded-xl px-6 py-6 [&>svg]:h-[200px] [&>svg]:w-auto [&>svg]:max-w-full">
      {Illustration && <Illustration />}
    </div>
    <h1 class="mt-8 max-w-4xl text-4xl sm:text-5xl leading-tight">{useCase.headline}</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">{useCase.intro}</p>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 grid gap-5 md:grid-cols-2">
    <div class="bg-band border border-line rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl">Sound familiar?</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted marker:text-accent">
        {useCase.signs.map((s) => <li>{s}</li>)}
      </ul>
    </div>
    <div class="bg-accent-soft border border-accent-line rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl">What we build</h2>
      <ul class="mt-4 space-y-2">
        {useCase.build.map((b) => (
          <li class="flex gap-3">
            <span class="font-semibold text-accent" aria-hidden="true">✓</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16">
    <div class="grid gap-8 md:grid-cols-[1fr_2fr]">
      <h2 class="text-2xl sm:text-3xl">Where it fits</h2>
      <div class="max-w-prose space-y-4 text-lg text-muted prose-links">
        {useCase.fits.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16 grid gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-2xl sm:text-3xl">What it can look like</h2>
      <p class="mt-4 text-lg text-muted">{useCase.example}</p>
      <p class="mt-3 text-sm text-muted">An illustrative scenario showing the shape of the work, not a specific client.</p>
    </div>
    <div>
      <h2 class="text-2xl sm:text-3xl">When it isn't an AI job</h2>
      <p class="mt-4 text-lg text-muted">{useCase.notAi}</p>
    </div>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16">
    <div class="bg-band border border-line rounded-xl p-6 sm:p-8 md:grid md:grid-cols-[1fr_2fr] md:gap-8">
      <h2 class="text-2xl sm:text-3xl">What it costs</h2>
      <div class="mt-4 max-w-prose md:mt-0">
        <p class="text-lg text-muted">We don't publish prices, because every job is different. Before any build you get a one-page cost check for your {useCase.short}: what it costs you now, what you'd save once your team is only checking the work, and what it would cost to run for the next 12 to 24 months, including if AI prices rise. If it doesn't pay back, we'll tell you not to build it.</p>
        <a href="/how-we-work/#cost-check" class="mt-4 inline-block font-medium text-accent hover:underline">How the cost check works →</a>
      </div>
    </div>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16">
    <div class="grid gap-8 md:grid-cols-[1fr_2fr]">
      <h2 class="text-2xl sm:text-3xl">Questions we get asked</h2>
      <div class="max-w-prose divide-y divide-line border-y border-line">
        {useCase.faq.map((f) => (
          <div class="py-5">
            <h3 class="text-xl">{f.q}</h3>
            <p class="mt-2 text-lg text-muted">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    heading={`Talk to us about ${useCase.short}.`}
    body="Describe how it works today and what's frustrating about it. We'll come back with an honest view on whether it's worth automating, and how."
  />

  <section class="max-w-page mx-auto px-4 sm:px-6">
    <h2 class="text-2xl">Other jobs we automate</h2>
    <ul class="mt-5 flex flex-wrap gap-3">
      {others.map((uc) => (
        <li>
          <a href={`/use-cases/${uc.slug}/`} class="block rounded-full border border-line px-4 py-2 text-sm transition-colors hover:border-accent hover:text-accent">{uc.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
