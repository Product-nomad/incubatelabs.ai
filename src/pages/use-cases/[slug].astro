---
import Layout from "@/layouts/Layout.astro";
import CallToAction from "@/components/CallToAction.astro";
import { useCases, type UseCase } from "@/data/useCases";

export function getStaticPaths() {
  return useCases.map((useCase) => ({ params: { slug: useCase.slug }, props: { useCase } }));
}

interface Props {
  useCase: UseCase;
}

const { useCase } = Astro.props;
const others = useCases.filter((uc) => uc.slug !== useCase.slug);
---

<Layout title={`${useCase.seoTitle} | Incubate Labs`} description={useCase.seoDescription}>
  <section class="max-w-page mx-auto px-4 sm:px-6 pt-12 pb-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/use-cases/" class="hover:text-accent">What we automate</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span aria-current="page" class="text-ink">{useCase.title}</span>
    </nav>
    <h1 class="mt-6 max-w-4xl text-4xl sm:text-5xl leading-tight">{useCase.headline}</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">{useCase.intro}</p>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 grid gap-5 md:grid-cols-2">
    <div class="bg-band border border-line rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl">Sound familiar?</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-muted marker:text-accent">
        {useCase.signs.map((s) => <li>{s}</li>)}
      </ul>
    </div>
    <div class="bg-accent-soft border border-accent-line rounded-xl p-6 sm:p-8">
      <h2 class="text-2xl">What we build</h2>
      <ul class="mt-4 space-y-2">
        {useCase.build.map((b) => (
          <li class="flex gap-3">
            <span class="font-semibold text-accent" aria-hidden="true">✓</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16 grid gap-10 md:grid-cols-2">
    <div>
      <h2 class="text-2xl sm:text-3xl">What it can look like</h2>
      <p class="mt-4 text-lg text-muted">{useCase.example}</p>
      <p class="mt-3 text-sm text-muted">An illustrative scenario showing the shape of the work, not a specific client.</p>
    </div>
    <div>
      <h2 class="text-2xl sm:text-3xl">When it isn't an AI job</h2>
      <p class="mt-4 text-lg text-muted">{useCase.notAi}</p>
    </div>
  </section>

  <CallToAction
    heading={`Talk to us about ${useCase.title.toLowerCase()}.`}
    body="Describe how it works today and what's frustrating about it. We'll come back with an honest view on whether it's worth automating, and how."
  />

  <section class="max-w-page mx-auto px-4 sm:px-6">
    <h2 class="text-2xl">Other jobs we automate</h2>
    <ul class="mt-5 flex flex-wrap gap-3">
      {others.map((uc) => (
        <li>
          <a href={`/use-cases/${uc.slug}/`} class="block rounded-full border border-line px-4 py-2 text-sm transition-colors hover:border-accent hover:text-accent">{uc.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
