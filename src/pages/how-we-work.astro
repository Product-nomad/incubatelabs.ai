---
import Layout from "@/layouts/Layout.astro";
import CallToAction from "@/components/CallToAction.astro";
import CostCheck from "@/components/CostCheck.astro";
import EngagementCard from "@/components/EngagementCard.astro";
import Commitments from "@/components/Commitments.astro";
import TeamChange from "@/components/TeamChange.astro";
import { engagements } from "@/data/engagements";
import { evidencePack } from "@/data/commitments";

const steps = [
  {
    title: "A conversation",
    body: "You tell us what's taking up your team's time. We ask a lot of questions about how the work happens today. We also agree where the hours saved should go, and how we'll know. This costs nothing.",
  },
  {
    title: "A written scope and cost check",
    body: "We send back a short, plain-English scope with a one-page cost check: what the job costs you now, what you'd save, and what it will cost to own, stress-tested against rising AI prices. Then a fixed price.",
  },
  {
    title: "The build",
    body: "We build against your real workflow and tools, and show you working versions early rather than a big reveal at the end.",
  },
  {
    title: "Handover",
    body: "We walk your team through it, leave simple instructions, and make sure it can run without us.",
  },
  {
    title: "After a quarter: we measure again",
    body: "Twelve weeks after go-live, we measure the same work the same way as at the start, and check whether the time went where you planned. If it's falling short, we agree what to change.",
  },
];

// The site's general FAQ. FAQPage JSON-LD is built from the same text as the visible answers.
const faq = [
  {
    q: "What if my team doesn't want to use it?",
    a: "That's common at the start, and it usually comes from worry about jobs or about the AI getting things wrong. We involve the person who does the work from day one, run the new way alongside the old one at first, and keep a person signing off anything that matters. It takes the parts of the job people dislike, not the job.",
  },
  {
    q: "What if people slip back to the old way?",
    a: "Some slipping is normal: new habits typically take around two months to settle. Fortnightly check-ins pick it up early, and it usually means something is awkward that we can fix. That's also why we measure at 12 weeks rather than straight after go-live.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};

// The points the five promises in "What we commit to" don't already cover (follow-up sprint, 2026-10).
const promises = [
  "Fixed scope and fixed price, agreed in writing before work starts",
  "Every scope says what's not included as clearly as what is",
  "Your data stays in your systems wherever possible, and we'll tell you exactly where it goes",
  "A cost check before any build, including what happens if AI prices rise",
];
---

<Layout
  title="Fixed-Price AI Consulting Services | Incubate Labs"
  description="How our AI consulting works: a free first call, a written scope and cost check, then a Quick Win, Automation Sprint or Operations Uplift. No retainers."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16 pb-12">
    <p class="text-sm font-medium text-accent">How we work</p>
    <h1 class="mt-4 max-w-4xl text-4xl sm:text-5xl leading-tight">Fixed-price AI consulting: small pieces of work that pay for themselves</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">
      No retainers and no open-ended day rates. Every engagement has a written scope and a fixed price, agreed before we start.
    </p>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-8 pb-20">
    <h2 class="text-3xl sm:text-4xl">From first call to handover</h2>
    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {steps.map((s, i) => (
        <li class="border border-line rounded-xl p-6">
          <span class="text-sm font-medium text-accent">Step {i + 1}</span>
          <h3 class="mt-3 text-xl">{s.title}</h3>
          <p class="mt-2 text-muted">{s.body}</p>
          {s.title === "Handover" && (
            <p id="evidence-pack" class="mt-4 border-t border-line pt-4 text-muted"><strong class="font-semibold text-ink">{evidencePack.lead}</strong> {evidencePack.text}</p>
          )}
        </li>
      ))}
    </ol>
  </section>

  <TeamChange />

  <Commitments />

  <section class="max-w-page mx-auto px-4 sm:px-6 pb-16">
    <h2 class="text-3xl sm:text-4xl">Three sizes of engagement</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {engagements.map((e) => <EngagementCard engagement={e} showGoodIf />)}
    </div>
    <div class="mt-5 bg-band border border-line rounded-xl p-6 sm:p-8">
      <h3 class="text-xl">Websites</h3>
      <p class="mt-2 max-w-prose text-muted">We also design and build websites for small businesses: fast, clear and easy to update. They can be added to any of the engagements above or done on their own.</p>
    </div>
  </section>

  <CostCheck showPanel={false} />

  <section class="max-w-page mx-auto px-4 sm:px-6 pb-4">
    <div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[1fr_2fr]">
      <h2 class="text-3xl sm:text-4xl">What you can hold us to</h2>
      <ul class="space-y-3 text-lg">
        {promises.map((p) => (
          <li class="flex gap-3">
            <span class="font-semibold text-accent" aria-hidden="true">✓</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16">
    <div class="grid gap-8 border-t border-line pt-10 md:grid-cols-[1fr_2fr]">
      <h2 class="text-3xl sm:text-4xl">Questions we get asked</h2>
      <div class="max-w-prose divide-y divide-line border-y border-line">
        {faq.map((f) => (
          <div class="faq-item py-5">
            <h3 class="text-xl">{f.q}</h3>
            <p class="mt-2 text-lg text-muted">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CallToAction />
</Layout>
