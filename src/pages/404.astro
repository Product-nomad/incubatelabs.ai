---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found | Incubate Labs" description="That page doesn't exist." noindex>
  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16 pb-12">
    <p class="text-sm font-medium text-accent">404</p>
    <h1 class="mt-4 text-4xl sm:text-5xl leading-tight">That page doesn't exist.</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted prose-links">
      Try the <a href="/">home page</a> or see <a href="/use-cases/">what we automate</a>.
    </p>
  </section>
</Layout>
