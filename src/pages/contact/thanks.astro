---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Message sent | Incubate Labs"
  description="Your message to Incubate Labs is on its way."
  noindex
>
  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16 pb-12">
    <p class="text-sm font-medium text-accent">Contact</p>
    <h1 class="mt-4 max-w-4xl text-4xl sm:text-5xl leading-tight">Thanks, we'll be in touch soon.</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">
      You'll get a personal reply, usually within a couple of working days.
    </p>
    <p class="mt-8"><a href="/" class="font-medium text-accent hover:underline">← Back to the home page</a></p>
  </section>
</Layout>
