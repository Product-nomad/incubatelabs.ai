---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/data/site";
import { getGuides, isResource, formatDate, isoDate } from "@/lib/guides";

const guides = await getGuides();
const [main, ...rest] = guides.filter((g) => !isResource(g));
const resources = guides.filter(isResource);
const url = `${site.url}/guides/`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Guides",
    url,
    description:
      "Plain-English guides to the EU AI Act, UK AI rules, chatbot disclosure and AI literacy for UK small businesses, plus a free AI policy template.",
    publisher: { "@id": `${site.url}/#org` },
    hasPart: guides.map((g) => ({ "@type": isResource(g) ? "CreativeWork" : "Article", name: g.data.h1, url: new URL(g.data.slug, site.url).href })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Guides", item: url },
    ],
  },
];

const reviewed = (d: Date) => `Last reviewed ${formatDate(d)}`;
---

<Layout
  title="AI Rules Guides for UK Small Businesses | Incubate Labs"
  description="Plain-English guides to the EU AI Act, UK AI rules, chatbot disclosure and AI literacy for UK small businesses, plus a free AI policy template."
  ogImage="/og/guides.png"
  ogImageAlt="AI rules guides for UK small businesses. incubatelabs.ai"
>
  {structuredData.map((d) => (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(d)} />
  ))}

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-x-1.5">
        <li><a href="/" class="hover:text-accent">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="text-ink">Guides</li>
      </ol>
    </nav>
    <h1 class="mt-6 text-4xl sm:text-5xl leading-tight">Guides</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">
      Plain-English guides to the rules on AI for UK small businesses. Each one has a last-reviewed date, because the rules keep changing.
    </p>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-10">
    <ul class="grid gap-5 md:grid-cols-2">
      {main && (
        <li class="md:col-span-2">
          <a href={main.data.slug} class="group block rounded-xl border border-accent-line bg-accent-soft p-6 sm:p-10 transition-colors hover:border-accent">
            <span class="text-xs font-medium uppercase tracking-wide text-accent">Start here</span>
            <span class="mt-3 block font-serif text-3xl sm:text-4xl font-semibold leading-tight group-hover:text-accent">{main.data.h1}</span>
            <span class="mt-4 block max-w-prose text-lg text-muted">{main.data.meta_description}</span>
            <span class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
              <time datetime={isoDate(main.data.last_reviewed)} class="text-muted">{reviewed(main.data.last_reviewed)}</time>
              <span class="font-medium text-accent">Read the guide →</span>
            </span>
          </a>
        </li>
      )}
      {rest.map((g) => (
        <li>
          <a href={g.data.slug} class="group flex h-full flex-col rounded-xl border border-line bg-paper p-6 transition-colors hover:border-accent">
            <span class="font-serif text-xl font-semibold leading-snug group-hover:text-accent">{g.data.h1}</span>
            <span class="mt-3 text-muted">{g.data.meta_description}</span>
            <time datetime={isoDate(g.data.last_reviewed)} class="mt-auto pt-4 text-sm text-muted">{reviewed(g.data.last_reviewed)}</time>
          </a>
        </li>
      ))}
      {resources.map((g) => (
        <li class="md:col-span-2">
          <a href={g.data.slug} class="group flex flex-col gap-2 rounded-xl border border-line bg-band p-6 transition-colors hover:border-accent sm:flex-row sm:items-center sm:justify-between sm:gap-8">
            <span>
              <span class="text-xs font-medium uppercase tracking-wide text-accent">Free resource</span>
              <span class="mt-2 block font-serif text-xl font-semibold leading-snug group-hover:text-accent">{g.data.h1}</span>
              <span class="mt-2 block max-w-prose text-muted">{g.data.meta_description}</span>
            </span>
            <span class="shrink-0 font-medium text-accent">Get the template →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
