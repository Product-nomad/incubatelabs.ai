---
import Layout from "@/layouts/Layout.astro";

const offerings = [
  {
    title: "Local-AI Sovereignty Check",
    length: "30 minutes",
    summary: "Which of your AI workflows actually need cloud LLMs and which could run locally. Names UK GDPR Article 44 cross-border-transfer risk specifically.",
    bring: "A 1-paragraph description of how AI sits in your product or operations today. Sub-processors named if you know them.",
    leave: "A 1-page diagnostic showing what could move local, what shouldn't, and the compliance risk you're carrying.",
    rightWhen: "Regulated sector. Sales blocked on \"where does the data go?\". DPO asking for a sub-processor list and you don't have one.",
  },
  {
    title: "AI Session Audit",
    length: "15 minutes",
    summary: "Live walkthrough of what your AI coding agent has been doing, using agentaudit on a sample of your team's recent Claude Code or Cursor sessions.",
    bring: "A zip of two or three recent .jsonl session files from ~/.claude/projects/ or your Cursor equivalent. Anonymise if needed.",
    leave: "A live look at any leaked secrets, risky shell, sensitive-path writes, or hook bypasses in the sample. Almost always uncovers something.",
    rightWhen: "Your team is using AI coding agents and nobody has audited what they're doing. You want a quick honest read before formalising a policy.",
  },
  {
    title: "AI Pilot Scope Workshop",
    length: "60 minutes",
    summary: "Bring an AI idea. Walk through the 6-question Discovery Call flow plus a Mom-Test-style critique. Leave with an evaluated brief.",
    bring: "An idea, a problem, or a hypothesis. The fuzzier the better — that's what the workshop is for.",
    leave: "An evaluated written brief with the niche, problem, prior attempts, blockers, and a recommended next step (usually: do 5–8 customer discovery calls before building).",
    rightWhen: "You're at the \"we should do something with AI\" stage and want a structured first pass before committing budget.",
  },
];
---

<Layout
  title="Free triage — Incubate Labs"
  description="Three free triage offerings: 15 to 60 minutes each, real diagnostic work, not sales calls."
>
  <section class="max-w-page mx-auto px-6 pt-16 pb-10">
    <p class="text-xs uppercase tracking-widest text-neutral-500 mb-4">Free triage</p>
    <h1 class="text-5xl font-bold tracking-tight mb-6">Three ways to find out, free.</h1>
    <p class="text-xl text-neutral-700 max-w-3xl leading-relaxed">
      Each is a real piece of diagnostic work, not a sales call. Pick the one that fits where
      you are; book it on the <a href="/contact/" class="text-accent hover:underline">contact page</a>.
    </p>
  </section>

  <hr class="max-w-page mx-auto" />

  <section class="max-w-3xl mx-auto px-6 py-12 space-y-12">
    {offerings.map((o) => (
      <article class="border border-neutral-200 rounded-lg p-8">
        <div class="flex items-baseline justify-between gap-4 mb-3 flex-wrap">
          <h2 class="text-2xl font-bold">{o.title}</h2>
          <span class="text-sm text-neutral-500 whitespace-nowrap">{o.length} · free</span>
        </div>
        <p class="text-neutral-700 leading-relaxed mb-6">{o.summary}</p>
        <dl class="grid sm:grid-cols-3 gap-4 text-sm">
          <div>
            <dt class="font-semibold text-ink mb-1">Bring</dt>
            <dd class="text-neutral-700 leading-relaxed">{o.bring}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink mb-1">Leave with</dt>
            <dd class="text-neutral-700 leading-relaxed">{o.leave}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink mb-1">Right when</dt>
            <dd class="text-neutral-700 leading-relaxed">{o.rightWhen}</dd>
          </div>
        </dl>
      </article>
    ))}

    <div class="text-center pt-8">
      <a href="/contact/" class="inline-flex items-center px-8 py-4 bg-ink text-paper font-medium rounded-md hover:bg-accent transition-colors">
        Book one
      </a>
    </div>
  </section>
</Layout>
