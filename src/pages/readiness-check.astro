---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/data/site";
import { steps } from "@/data/readiness";
import { turnstileSiteKey } from "@/lib/turnstile";

const mailto = `mailto:${site.email}?subject=${encodeURIComponent("Enquiry from incubatelabs.ai")}`;
const buttonPrimary = "bg-ink text-paper rounded-md px-6 py-3 font-medium transition-colors hover:bg-accent";
const buttonSecondary = "border border-ink text-ink rounded-md px-6 py-3 font-medium transition-colors hover:bg-ink hover:text-paper";
---

<Layout
  title="Free AI readiness check | Incubate Labs"
  description="A free, five-minute check for UK small businesses: find out which jobs are worth automating with AI first, and what to sort out before you start."
>
  {turnstileSiteKey && (
    <script slot="head" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <section id="rc-intro" class="max-w-page mx-auto px-4 sm:px-6 pt-16 pb-12">
    <p class="text-sm font-medium text-accent">Free Readiness Check</p>
    <h1 class="mt-4 max-w-4xl text-4xl sm:text-5xl leading-tight">Where would AI actually help your business?</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">
      Answer a few questions about how work happens day to day. You'll see which jobs are worth automating first, and what to sort out before you start. It takes about five minutes and you don't need to give us your email.
    </p>
    <button type="button" id="rc-start" class={`mt-8 ${buttonPrimary}`}>Start the check</button>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6">
    <form id="rc-form" class="hidden max-w-3xl" novalidate>
      <div class="mb-8">
        <p id="rc-progress-label" class="text-sm font-medium text-accent" aria-live="polite">Step 1 of {steps.length}</p>
        <div class="mt-2 h-1.5 w-full rounded-full bg-line" aria-hidden="true">
          <div id="rc-progress-bar" class="h-1.5 rounded-full bg-accent transition-all" style={`width: ${100 / steps.length}%`}></div>
        </div>
      </div>

      {steps.map((step, i) => (
        <div class="rc-step hidden" data-step={i}>
          <h2 class="text-3xl sm:text-4xl" tabindex="-1">{step.title}</h2>
          {i === steps.length - 1 && (
            <p class="mt-3 text-lg text-muted">These questions are about <span id="rc-job" class="font-medium text-ink">the job that takes up most time</span>.</p>
          )}
          <div class="mt-8 space-y-8">
            {step.questions.map((q) => (
              <fieldset data-question={q.id}>
                <legend class="text-lg font-medium text-ink">{q.text}</legend>
                <div class="mt-3 grid gap-2 sm:grid-cols-2">
                  {q.options.map((o) => (
                    <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-line bg-white px-4 py-3 transition-colors hover:border-accent has-[:checked]:border-accent has-[:checked]:bg-accent-soft">
                      <input type="radio" name={q.id} value={o.value} class="mt-1 accent-accent" />
                      <span>{o.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>
        </div>
      ))}

      <p id="rc-missing" role="alert" class="mt-6 hidden text-sm text-ink">Please answer every question to carry on.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <button type="button" id="rc-back" class={buttonSecondary}>Back</button>
        <button type="submit" id="rc-next" class={buttonPrimary}>Next</button>
      </div>
    </form>

    <div id="rc-result" class="hidden max-w-3xl">
      <p class="text-sm font-medium text-accent">Your result</p>
      <h2 class="mt-3 text-3xl sm:text-4xl" tabindex="-1" id="rc-result-heading">Worth automating first</h2>
      <ol id="rc-recs" class="mt-6 space-y-4"></ol>
      <p id="rc-none" class="mt-6 hidden text-lg text-muted">
        Nothing stands out from your answers. That's useful to know too. If something is still eating your week, a short conversation is the quickest way to find out whether it's worth automating.
      </p>

      <div class="mt-10 bg-band border border-line rounded-xl p-6 sm:p-8">
        <h3 class="text-2xl">Before you start</h3>
        <ul id="rc-points" class="mt-4 space-y-3 text-muted"></ul>
      </div>

      <div class="mt-10 flex flex-wrap gap-3">
        {site.bookingUrl && (
          <a href={site.bookingUrl} target="_blank" rel="noopener" class={buttonPrimary}>Book a call to talk it through</a>
        )}
        <button type="button" id="rc-email-open" class={site.bookingUrl ? buttonSecondary : buttonPrimary}>Email me my result</button>
      </div>

      <form id="rc-email-form" class="mt-6 hidden max-w-xl border border-line rounded-xl p-6" action="/api/contact" method="post">
        <input type="hidden" name="source" value="readiness-check" />
        <input type="hidden" name="message" id="rc-summary" />
        <label for="rc-email" class="font-medium">Your email</label>
        <input id="rc-email" name="email" type="email" autocomplete="email" required maxlength="320" class="mt-2 block w-full rounded-md border border-line bg-white px-3 py-2.5 text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
        <p class="mt-2 text-sm text-muted prose-links">Your result goes to Simon, who will email it to you personally. We only use your address to reply. See our <a href="/privacy/">privacy notice</a>.</p>
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="rc-website">Leave this field empty</label>
          <input id="rc-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        {turnstileSiteKey && <div class="cf-turnstile mt-4" data-sitekey={turnstileSiteKey}></div>}
        <button type="submit" class={`mt-4 ${buttonPrimary} disabled:opacity-60`}>Send my result</button>
        <p id="rc-email-error" role="alert" class="mt-4 hidden text-sm text-ink">
          Sorry, that didn't send. Please email <a href={mailto} class="text-accent underline">{site.email}</a> instead.
        </p>
      </form>
      <p id="rc-email-sent" role="status" class="mt-6 hidden text-lg">Thanks. Simon will email your result to you personally.</p>

      <p class="mt-10 text-sm text-muted">This is a starting point, not a diagnosis. Every business is different.</p>
      <button type="button" id="rc-restart" class="mt-4 text-sm font-medium text-accent hover:underline">Start again</button>
    </div>
  </section>
</Layout>

<script>
  import { steps, computeResult, summarise, type Answers } from "@/data/readiness";
  import { useCases } from "@/data/useCases";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>("rc-form");
  const stepEls = Array.from(document.querySelectorAll<HTMLElement>(".rc-step"));
  const back = $<HTMLButtonElement>("rc-back");
  const next = $<HTMLButtonElement>("rc-next");
  const missing = $("rc-missing");
  const result = $("rc-result");
  let current = 0;

  function answers(): Answers {
    const data = new FormData(form);
    return Object.fromEntries(Array.from(data.entries()).map(([k, v]) => [k, String(v)]));
  }

  function show(step: number) {
    current = step;
    stepEls.forEach((el, i) => el.classList.toggle("hidden", i !== step));
    $("rc-progress-label").textContent = `Step ${step + 1} of ${steps.length}`;
    $("rc-progress-bar").style.width = `${((step + 1) / steps.length) * 100}%`;
    back.classList.toggle("hidden", step === 0);
    next.textContent = step === steps.length - 1 ? "See my result" : "Next";
    missing.classList.add("hidden");
    if (step === steps.length - 1) {
      const picked = useCases.find((uc) => uc.slug === answers().pick);
      $("rc-job").textContent = picked ? picked.title.toLowerCase() : "the job that takes up most time";
    }
    stepEls[step].querySelector<HTMLElement>("h2")?.focus();
    window.scrollTo({ top: form.getBoundingClientRect().top + window.scrollY - 24 });
  }

  function stepComplete(step: number): boolean {
    const a = answers();
    return steps[step].questions.every((q) => a[q.id]);
  }

  function renderResult() {
    const a = answers();
    const r = computeResult(a);
    const recs = $("rc-recs");
    recs.replaceChildren(
      ...r.recommendations.map((rec) => {
        const li = document.createElement("li");
        li.className = "border border-line rounded-xl p-5";
        const link = document.createElement("a");
        link.href = `/use-cases/${rec.slug}/`;
        link.className = "font-serif text-xl font-semibold text-ink hover:text-accent";
        link.textContent = `${rec.title} →`;
        const reason = document.createElement("p");
        reason.className = "mt-1 text-muted";
        reason.textContent = rec.reason;
        li.append(link, reason);
        return li;
      }),
    );
    $("rc-none").classList.toggle("hidden", r.recommendations.length > 0);
    recs.classList.toggle("hidden", r.recommendations.length === 0);
    $("rc-points").replaceChildren(
      ...r.beforeYouStart.map((p) => {
        const li = document.createElement("li");
        const lead = document.createElement("strong");
        lead.className = "font-semibold text-ink";
        lead.textContent = p.lead;
        li.append(lead, ` ${p.body}`);
        return li;
      }),
    );
    $<HTMLInputElement>("rc-summary").value = summarise(a, r);
    form.classList.add("hidden");
    result.classList.remove("hidden");
    $("rc-result-heading").focus();
    window.scrollTo({ top: result.getBoundingClientRect().top + window.scrollY - 24 });
  }

  $("rc-start").addEventListener("click", () => {
    $("rc-start").classList.add("hidden");
    form.classList.remove("hidden");
    show(0);
  });

  back.addEventListener("click", () => show(Math.max(0, current - 1)));

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!stepComplete(current)) {
      missing.classList.remove("hidden");
      return;
    }
    if (current < steps.length - 1) show(current + 1);
    else renderResult();
  });

  $("rc-restart").addEventListener("click", () => {
    form.reset();
    result.classList.add("hidden");
    $("rc-email-form").classList.add("hidden");
    $("rc-email-sent").classList.add("hidden");
    $("rc-email-open").classList.remove("hidden");
    form.classList.remove("hidden");
    show(0);
  });

  $("rc-email-open").addEventListener("click", () => {
    $("rc-email-open").classList.add("hidden");
    $("rc-email-form").classList.remove("hidden");
    $("rc-email").focus();
  });

  const emailForm = $<HTMLFormElement>("rc-email-form");
  emailForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = emailForm.querySelector("button[type=submit]") as HTMLButtonElement;
    const error = $("rc-email-error");
    button.disabled = true;
    error.classList.add("hidden");
    try {
      const res = await fetch(emailForm.action, {
        method: "POST",
        body: new FormData(emailForm),
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(String(res.status));
      emailForm.classList.add("hidden");
      $("rc-email-sent").classList.remove("hidden");
    } catch {
      error.classList.remove("hidden");
      button.disabled = false;
      (window as any).turnstile?.reset();
    }
  });

</script>
