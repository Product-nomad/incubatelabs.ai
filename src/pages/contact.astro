---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/data/site";
import { turnstileSiteKey } from "@/lib/turnstile";

const mailto = `mailto:${site.email}?subject=${encodeURIComponent("Enquiry from incubatelabs.ai")}`;
const inputClass =
  "mt-2 block w-full rounded-md border border-line bg-white px-3 py-2.5 text-ink focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent";
---

<Layout
  title="Contact: Book a Free AI Consultation | Incubate Labs"
  description="Tell us what's eating your week. Book a free 30-minute call or send a message about practical AI and automation for your small business."
>
  {turnstileSiteKey && (
    <script slot="head" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-16 pb-12">
    <p class="text-sm font-medium text-accent">Contact</p>
    <h1 class="mt-4 max-w-4xl text-4xl sm:text-5xl leading-tight">Tell us what's eating your week.</h1>
    <p class="mt-6 max-w-prose text-lg sm:text-xl text-muted leading-relaxed">
      The first conversation is free and there's no obligation. If AI isn't the right answer, you'll hear that from us straight away.
    </p>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 grid gap-8 lg:grid-cols-[3fr_2fr]">
    <div class="border border-line rounded-xl p-6 sm:p-8">
      <div id="contact-form-wrap">
        <h2 class="text-2xl">Send us a message</h2>
        <form id="contact-form" action="/api/contact" method="post" class="mt-6 space-y-5">
          <input type="hidden" name="source" value="contact" />
          <div>
            <label for="name" class="font-medium">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="200" class={inputClass} />
          </div>
          <div>
            <label for="email" class="font-medium">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="320" class={inputClass} />
          </div>
          <div>
            <label for="business" class="font-medium">Business name <span class="font-normal text-muted">(optional)</span></label>
            <input id="business" name="business" type="text" autocomplete="organization" maxlength="200" class={inputClass} />
          </div>
          <div>
            <label for="message" class="font-medium">What's taking up too much time?</label>
            <textarea id="message" name="message" rows="6" required maxlength="5000" aria-describedby="message-help" class={inputClass}></textarea>
            <p id="message-help" class="mt-2 text-sm text-muted">A few lines is plenty: what your business does, the job that's eating time, who does it today and which tools are involved. We'll ask the rest.</p>
          </div>
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          {turnstileSiteKey && (
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
          )}
          <div>
            <button type="submit" class="bg-ink text-paper rounded-md px-6 py-3 font-medium transition-colors hover:bg-accent disabled:opacity-60">Send message</button>
            <p id="contact-error" role="alert" class="mt-4 hidden text-sm text-ink">
              Sorry, that didn't send. Please email <a href={mailto} class="text-accent underline">{site.email}</a> instead.
            </p>
            <p class="mt-4 text-sm text-muted prose-links">We only use your details to reply. See our <a href="/privacy/">privacy notice</a>.</p>
          </div>
        </form>
      </div>
      <p id="contact-success" role="status" class="hidden text-lg" tabindex="-1">
        Thanks — your message is on its way to Simon. You'll get a personal reply, usually within a couple of working days.
      </p>
    </div>

    <div class="space-y-5">
      {site.bookingUrl && (
        <div class="bg-ink text-paper rounded-xl p-6 sm:p-8">
          <h2 class="text-2xl">Book a call</h2>
          <p class="mt-3 text-paper/80">Prefer to talk? Pick a time for a free 30-minute call.</p>
          <a href={site.bookingUrl} target="_blank" rel="noopener" class="mt-6 inline-block bg-paper text-ink rounded-md px-6 py-3 font-medium transition-colors hover:bg-accent-soft">Book a call →</a>
        </div>
      )}
      <div class="border border-line rounded-xl p-6 sm:p-8">
        <h2 class="text-2xl">Email</h2>
        <p class="mt-3 text-muted">Or email us directly.</p>
        <p class="mt-3"><a href={mailto} class="font-medium text-accent hover:underline">{site.email}</a></p>
      </div>
    </div>
  </section>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-8">
    <p class="bg-accent-soft rounded-xl px-6 py-4 text-muted prose-links">
      Not ready to talk yet? Take the free <a href="/readiness-check/">Readiness Check</a> to see where AI could help first.
    </p>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const wrap = document.getElementById("contact-form-wrap");
  const success = document.getElementById("contact-success");
  const error = document.getElementById("contact-error");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement;
    button.disabled = true;
    error?.classList.add("hidden");
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(String(res.status));
      wrap?.classList.add("hidden");
      success?.classList.remove("hidden");
      success?.focus();
    } catch {
      error?.classList.remove("hidden");
      button.disabled = false;
      // Turnstile tokens are single-use; get a fresh one for a retry.
      (window as any).turnstile?.reset();
    }
  });
</script>
