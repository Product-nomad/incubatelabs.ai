---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Contact — Incubate Labs"
  description="Book a 30-min call, or email directly. UK-hours-friendly across EU and US clients."
>
  <section class="max-w-page mx-auto px-6 pt-16 pb-10">
    <p class="text-xs uppercase tracking-widest text-neutral-500 mb-4">Contact</p>
    <h1 class="text-5xl font-bold tracking-tight mb-6">Book a 30-min call.</h1>
    <p class="text-xl text-neutral-700 max-w-3xl leading-relaxed">
      Three free triage formats — pick one when booking. If we shouldn't work together, you'll
      know inside 30 minutes; that's a feature.
    </p>
  </section>

  <hr class="max-w-page mx-auto" />

  <section class="max-w-3xl mx-auto px-6 py-12">
    <div class="border border-neutral-200 rounded-lg p-8">
      <h2 class="text-2xl font-bold mb-4">Book a slot</h2>
      <p class="text-neutral-700 mb-6">
        Calendar embed lands here once Cal.com is set up.
        For now, email
        <a href="mailto:hello@incubatelabs.ai" class="text-accent hover:underline">hello@incubatelabs.ai</a>
        with a one-paragraph context and which of the three
        <a href="/free/" class="text-accent hover:underline">free triage formats</a> looks like
        the right fit.
      </p>

      <!--
        TODO(cal): replace this placeholder with the Cal.com inline embed.
        See https://cal.com/docs/embed/embed-instructions/inline-embed
      -->
      <div class="border-2 border-dashed border-neutral-300 rounded-md p-12 text-center text-neutral-500">
        Cal.com inline embed → <code class="text-xs">cal.com/incubatelabs</code>
        <p class="text-xs mt-2">(placeholder — wire up before launch)</p>
      </div>
    </div>

    <div class="mt-12 grid sm:grid-cols-2 gap-6">
      <div>
        <h3 class="font-semibold mb-2">Direct</h3>
        <p class="text-sm text-neutral-700">
          Email: <a href="mailto:hello@incubatelabs.ai" class="text-accent hover:underline">hello@incubatelabs.ai</a><br />
          X: <a href="https://x.com/product_nomad" class="text-accent hover:underline">@product_nomad</a><br />
          GitHub: <a href="https://github.com/Product-nomad" class="text-accent hover:underline">Product-nomad</a>
        </p>
      </div>
      <div>
        <h3 class="font-semibold mb-2">Working hours</h3>
        <p class="text-sm text-neutral-700">
          Based in London (Europe/London).<br />
          Calls available 09:00–18:00 UK time.<br />
          Friendly to EU mornings and US afternoons.
        </p>
      </div>
    </div>
  </section>
</Layout>
