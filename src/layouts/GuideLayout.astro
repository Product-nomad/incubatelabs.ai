---
// One layout for the four guides and the AI policy template (design/guides-2026-10/00-build-spec.md §2).
import Layout from "@/layouts/Layout.astro";
import "@/styles/prose.css";
import { render } from "astro:content";
import { site } from "@/data/site";
import { type Guide, getGuides, isResource, formatDate, isoDate, ogImagePath } from "@/lib/guides";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { data } = guide;
const { Content, remarkPluginFrontmatter } = await render(guide);
const faq: { q: string; a: string }[] = remarkPluginFrontmatter.faq ?? [];

const url = new URL(data.slug, site.url).href;
const resource = isResource(guide);
const parent = resource
  ? { name: "Resources", item: null }
  : { name: "Guides", item: `${site.url}/guides/` };
const crumb = resource ? "AI policy template" : data.h1;
// "More guides": four cards (one row on desktop), the first three other guides in display order plus
// the policy template.
const all = (await getGuides()).filter((g) => g.id !== guide.id);
const others = [...all.filter((g) => !isResource(g)).slice(0, all.some(isResource) ? 3 : 4), ...all.filter(isResource)].slice(0, 4);
const org = {
  "@type": "Organization",
  name: site.name,
  url: site.url,
  logo: { "@type": "ImageObject", url: `${site.url}/brand/incubatelabs-logo.svg` },
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.h1,
    description: data.meta_description,
    url,
    mainEntityOfPage: url,
    image: new URL(ogImagePath(guide), site.url).href,
    datePublished: isoDate(data.last_reviewed),
    dateModified: isoDate(data.last_reviewed),
    inLanguage: "en-GB",
    author: org,
    publisher: org,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    // /resources/ has no index page: Google needs a URL on every crumb but the last, so the
    // visible "Resources" crumb is left out of the structured data.
    itemListElement: [
      { name: "Home", item: `${site.url}/` },
      ...(parent.item ? [{ name: parent.name, item: parent.item }] : []),
      { name: crumb, item: url },
    ].map((c, i) => ({ "@type": "ListItem", position: i + 1, ...c })),
  },
  ...(faq.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faq.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },
      ]
    : []),
];
---

<Layout
  title={data.title}
  description={data.meta_description}
  canonical={url}
  ogImage={ogImagePath(guide)}
  ogImageAlt={`${data.h1} incubatelabs.ai`}
  ogType="article"
>
  {structuredData.map((d) => (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(d)} />
  ))}
  <meta slot="head" property="article:modified_time" content={isoDate(data.last_reviewed)} />
  <slot name="head" slot="head" />

  <article class="max-w-page mx-auto px-4 sm:px-6 pt-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
        <li><a href="/" class="hover:text-accent">Home</a></li>
        <li aria-hidden="true">›</li>
        <li>{parent.item ? <a href="/guides/" class="hover:text-accent">{parent.name}</a> : parent.name}</li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="text-ink">{crumb}</li>
      </ol>
    </nav>

    <header class="guide-measure">
      <h1 class="mt-6 text-4xl sm:text-5xl leading-tight">{data.h1}</h1>
      <p class="mt-4 text-sm text-muted">
        Last reviewed: <time datetime={isoDate(data.last_reviewed)}>{formatDate(data.last_reviewed)}</time>
        <span aria-hidden="true" class="mx-1.5">·</span>
        Practical guidance, not legal advice.
      </p>
    </header>

    <div class="guide-prose guide-measure mt-8">
      <Content />
    </div>
  </article>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-20" aria-labelledby="more-guides">
    <h2 id="more-guides" class="text-2xl sm:text-3xl">More guides</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {others.map((g) => (
        <li>
          <a href={g.data.slug} class="group flex h-full flex-col rounded-xl border border-line bg-paper p-5 transition-colors hover:border-accent">
            {isResource(g) && <span class="mb-2 text-xs font-medium uppercase tracking-wide text-accent">Free resource</span>}
            <span class="font-serif text-lg font-semibold leading-snug group-hover:text-accent">{g.data.h1}</span>
            <span class="mt-2 text-sm text-muted">{g.data.meta_description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
