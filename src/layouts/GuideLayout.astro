---
// One layout for the four guides and the AI policy template (design/guides-2026-10/00-build-spec.md §2).
import Layout from "@/layouts/Layout.astro";
import { render } from "astro:content";
import { site } from "@/data/site";
import { type Guide, getGuides, isResource, formatDate, isoDate, ogImagePath } from "@/lib/guides";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { data } = guide;
const { Content, remarkPluginFrontmatter } = await render(guide);
const faq: { q: string; a: string }[] = remarkPluginFrontmatter.faq ?? [];

const url = new URL(data.slug, site.url).href;
const resource = isResource(guide);
const parent = resource
  ? { name: "Resources", item: null }
  : { name: "Guides", item: `${site.url}/guides/` };
const crumb = resource ? "AI policy template" : data.h1;
const others = (await getGuides()).filter((g) => g.id !== guide.id);
const org = {
  "@type": "Organization",
  name: site.name,
  url: site.url,
  logo: { "@type": "ImageObject", url: `${site.url}/brand/incubatelabs-logo.svg` },
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.h1,
    description: data.meta_description,
    url,
    mainEntityOfPage: url,
    image: new URL(ogImagePath(guide), site.url).href,
    datePublished: isoDate(data.last_reviewed),
    dateModified: isoDate(data.last_reviewed),
    inLanguage: "en-GB",
    author: org,
    publisher: org,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    // /resources/ has no index page, so that crumb has no link.
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: parent.name, ...(parent.item ? { item: parent.item } : {}) },
      { "@type": "ListItem", position: 3, name: crumb, item: url },
    ],
  },
  ...(faq.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faq.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },
      ]
    : []),
];
---

<Layout
  title={data.title}
  description={data.meta_description}
  canonical={url}
  ogImage={ogImagePath(guide)}
  ogImageAlt={`${data.h1} incubatelabs.ai`}
  ogType="article"
>
  {structuredData.map((d) => (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(d)} />
  ))}
  <meta slot="head" property="article:modified_time" content={isoDate(data.last_reviewed)} />
  <slot name="head" slot="head" />

  <article class="max-w-page mx-auto px-4 sm:px-6 pt-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
        <li><a href="/" class="hover:text-accent">Home</a></li>
        <li aria-hidden="true">›</li>
        <li>{parent.item ? <a href="/guides/" class="hover:text-accent">{parent.name}</a> : parent.name}</li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="text-ink">{crumb}</li>
      </ol>
    </nav>

    <header class="guide-measure">
      <h1 class="mt-6 text-4xl sm:text-5xl leading-tight">{data.h1}</h1>
      <p class="mt-4 text-sm text-muted">
        Last reviewed: <time datetime={isoDate(data.last_reviewed)}>{formatDate(data.last_reviewed)}</time>
        <span aria-hidden="true" class="mx-1.5">·</span>
        Practical guidance, not legal advice.
      </p>
    </header>

    <div class="guide-prose guide-measure mt-8">
      <Content />
    </div>
  </article>

  <section class="max-w-page mx-auto px-4 sm:px-6 pt-20" aria-labelledby="more-guides">
    <h2 id="more-guides" class="text-2xl sm:text-3xl">More guides</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {others.map((g) => (
        <li>
          <a href={g.data.slug} class="group flex h-full flex-col rounded-xl border border-line bg-paper p-5 transition-colors hover:border-accent">
            {isResource(g) && <span class="mb-2 text-xs font-medium uppercase tracking-wide text-accent">Free resource</span>}
            <span class="font-serif text-lg font-semibold leading-snug group-hover:text-accent">{g.data.h1}</span>
            <span class="mt-2 text-sm text-muted">{g.data.meta_description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style is:global>
  .guide-measure {
    max-width: 68ch;
  }

  .guide-prose {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .guide-prose > * + * {
    margin-top: 2.5rem;
  }
  .guide-prose p,
  .guide-prose ul,
  .guide-prose ol,
  .guide-prose blockquote,
  .guide-prose .table-wrap {
    margin-top: 1rem;
  }
  .guide-prose .guide-intro > :first-child {
    margin-top: 0;
  }
  .guide-prose h2 {
    font-size: 1.75rem;
    line-height: 1.25;
    scroll-margin-top: 1.5rem;
  }
  .guide-prose h3,
  .guide-prose h4 {
    font-family: "Source Serif 4", Georgia, serif;
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.35;
    margin-top: 1.75rem;
  }
  .guide-prose h4 {
    font-size: 1.125rem;
  }
  .guide-prose strong {
    font-weight: 600;
  }
  .guide-prose ul {
    list-style: disc;
    padding-left: 1.4rem;
  }
  .guide-prose ol {
    list-style: decimal;
    padding-left: 1.6rem;
  }
  .guide-prose li + li {
    margin-top: 0.4rem;
  }
  .guide-prose li::marker {
    color: #1f5c45;
  }
  .guide-prose a {
    color: #1f5c45;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .guide-prose a:hover {
    text-decoration-thickness: 2px;
  }

  /* Tables: 1px line borders, band header row, sideways scroll on narrow screens. */
  .guide-prose .table-wrap {
    overflow-x: auto;
    border: 1px solid #e4e1da;
    border-radius: 0.5rem;
  }
  .guide-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .guide-prose th,
  .guide-prose td {
    border: 1px solid #e4e1da;
    padding: 0.6rem 0.8rem;
    text-align: left;
    vertical-align: top;
    min-width: 9rem;
  }
  .guide-prose tr > :first-child {
    border-left: 0;
  }
  .guide-prose tr > :last-child {
    border-right: 0;
  }
  .guide-prose thead tr:first-child > * {
    border-top: 0;
  }
  .guide-prose tbody tr:last-child > * {
    border-bottom: 0;
  }
  .guide-prose th {
    background: #f4f2ed;
    font-weight: 600;
  }

  .guide-prose blockquote {
    border-left: 3px solid #1f5c45;
    background: #e8efe9;
    padding: 1rem 1.25rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  /* "How we can help" callout card. */
  .guide-prose .guide-help {
    background: #e8efe9;
    border: 1px solid #cfe0d4;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }
  @media (min-width: 640px) {
    .guide-prose .guide-help {
      padding: 2rem;
    }
  }
  .guide-prose .guide-help h2 {
    font-size: 1.5rem;
  }
  .guide-prose a.btn-primary,
  .guide-prose a.btn-secondary,
  .guide-prose button.btn-secondary {
    display: inline-block;
    border-radius: 0.375rem;
    padding: 0.75rem 1.5rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }
  .guide-prose a.btn-primary {
    background: #16181a;
    color: #fbfaf7;
  }
  .guide-prose a.btn-primary:hover {
    background: #1f5c45;
  }
  .guide-prose a.btn-secondary,
  .guide-prose button.btn-secondary {
    border: 1px solid #16181a;
    color: #16181a;
    background: transparent;
    cursor: pointer;
  }
  .guide-prose a.btn-secondary:hover,
  .guide-prose button.btn-secondary:hover {
    background: #16181a;
    color: #fbfaf7;
  }

  .guide-prose .faq-item + .faq-item {
    margin-top: 1.5rem;
  }
  .guide-prose .faq-item p {
    margin-top: 0.4rem;
    color: #5d6166;
  }

  .guide-prose .guide-sources {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #5d6166;
  }
  .guide-prose .guide-sources h2 {
    font-size: 1.25rem;
    color: #16181a;
  }
  .guide-prose .guide-sources a {
    overflow-wrap: anywhere;
  }

  /* AI policy template: download buttons and the document panel. */
  .guide-prose .template-download {
    margin-top: 1.5rem;
  }
  .guide-prose .template-note {
    font-size: 0.9375rem;
  }
  .guide-prose .template-buttons {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .guide-prose .copy-status {
    font-size: 0.875rem;
    color: #1f5c45;
    font-weight: 500;
  }
  .guide-prose .template-doc {
    margin-top: 1.25rem;
    background: #fbfaf7;
    border: 1px solid #e4e1da;
    border-radius: 0.5rem;
    padding: 1.5rem 1.25rem;
    box-shadow: inset 0 1px 3px rgba(22, 24, 26, 0.06);
  }
  @media (min-width: 640px) {
    .guide-prose .template-doc {
      margin-inline: 0.75rem;
      padding: 2rem 2.25rem;
    }
  }
  .guide-prose .template-doc > :first-child {
    margin-top: 0;
    font-size: 1.5rem;
  }
</style>
