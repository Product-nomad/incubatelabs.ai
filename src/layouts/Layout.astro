---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/source-serif-4/500.css";
import "@fontsource/source-serif-4/600.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const fullCanonical = canonical || new URL(Astro.url.pathname, site.url).href;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: site.url,
  email: site.email,
  description: "Practical AI and automation for UK small businesses without an in-house IT team.",
  founder: { "@type": "Person", name: site.founder },
  areaServed: { "@type": "Country", name: "United Kingdom" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Huntingdon",
    addressRegion: "Cambridgeshire",
    addressCountry: "GB",
  },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={fullCanonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf7" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {plausibleDomain && (
      <script
        defer
        is:inline
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html {
    -webkit-text-size-adjust: 100%;
  }

  h1,
  h2,
  h3 {
    font-family: "Source Serif 4", Georgia, serif;
    font-weight: 600;
    text-wrap: balance;
  }

  ::selection {
    background: #1f5c45;
    color: #fbfaf7;
  }

  :focus-visible {
    outline: 2px solid #1f5c45;
    outline-offset: 3px;
  }

  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }

  .prose-links a {
    color: #1f5c45;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-links a:hover {
    text-decoration-thickness: 2px;
  }
</style>
