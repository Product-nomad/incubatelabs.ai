---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/source-serif-4/500.css";
import "@fontsource/source-serif-4/600.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import AnnouncementBar, { ANNOUNCEMENT_KEY } from "@/components/AnnouncementBar.astro";
import { site } from "@/data/site";
// Heading and body fonts, preloaded so text don't reflow when it arrives (technical audit issue 10).
import serifHeading from "@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2?url";
import interBody from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  // Shorter description for social previews (og:/twitter:), which cut off around 125 characters.
  socialDescription?: string;
  // Per-page social card (site-relative path) and its alt text; defaults to the site-wide card.
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  canonical,
  noindex = false,
  socialDescription = description,
  ogImage: ogImagePath,
  ogImageAlt = "Practical AI and automation for small businesses. incubatelabs.ai",
  ogType = "website",
} = Astro.props;
const fullCanonical = canonical || new URL(Astro.url.pathname, site.url).href;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
// The announcement points at this guide, so it isn't shown there.
const showAnnouncement = Astro.url.pathname !== "/guides/eu-ai-act-uk/";

const siteOgImage = `${site.url}/og-image.png`;
const ogImage = ogImagePath ? new URL(ogImagePath, site.url).href : siteOgImage;

// No address: the site shows no location (v1.1 spec §9).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site.url}/#org`,
  name: site.name,
  url: site.url,
  email: site.email,
  image: siteOgImage,
  logo: `${site.url}/brand/incubatelabs-logo.svg`,
  description: site.description,
  founder: { "@type": "Person", name: site.founder, jobTitle: "Founder", url: `${site.url}/about/` },
  areaServed: { "@type": "Country", name: "United Kingdom" },
  knowsAbout: [
    "AI automation",
    "document processing",
    "workflow automation",
    "EU AI Act compliance for small businesses",
  ],
  sameAs: [site.github],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    {showAnnouncement && (
      <script is:inline define:vars={{ key: ANNOUNCEMENT_KEY }}>
        try {
          if (localStorage.getItem(key) === "1") document.documentElement.classList.add("bar-dismissed");
        } catch (e) {}
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.bingSiteVerification && <meta name="msvalidate.01" content={site.bingSiteVerification} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={fullCanonical} />}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={serifHeading} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interBody} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfaf7" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {plausibleDomain && (
      <script
        defer
        is:inline
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>
    {showAnnouncement && <AnnouncementBar />}
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html {
    -webkit-text-size-adjust: 100%;
  }

  h1,
  h2,
  h3 {
    font-family: "Source Serif 4", Georgia, serif;
    font-weight: 600;
    text-wrap: balance;
  }

  ::selection {
    background: #1f5c45;
    color: #fbfaf7;
  }

  :focus-visible {
    outline: 2px solid #1f5c45;
    outline-offset: 3px;
  }

  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }

  .prose-links a {
    color: #1f5c45;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-links a:hover {
    text-decoration-thickness: 2px;
  }
</style>
