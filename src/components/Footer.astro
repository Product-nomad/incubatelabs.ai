---
import { site } from "@/data/site";
import { useCases } from "@/data/useCases";
import Logo from "@/components/Logo.astro";

const year = new Date().getFullYear();
const linkClass = "text-muted hover:text-accent transition-colors";
---

<footer class="bg-band border-t border-line mt-20">
  <div class="max-w-page mx-auto px-4 sm:px-6 py-12 grid gap-10 text-sm sm:grid-cols-2 lg:grid-cols-5">
    <div>
      <Logo height={32} />
      <p class="mt-2 text-muted">Practical AI for small businesses. We build it, you use it.</p>
    </div>
    <div>
      <p class="font-medium text-ink">Where we can help</p>
      <ul class="mt-3 space-y-2">
        {useCases.map((uc) => (
          <li><a href={`/use-cases/${uc.slug}/`} class={linkClass}>{uc.title}</a></li>
        ))}
        <li><a href="/examples/" class={linkClass}>Worked examples</a></li>
        <li><a href="/use-cases/#websites" class={linkClass}>Websites</a></li>
      </ul>
    </div>
    <div>
      <p class="font-medium text-ink">Guides</p>
      <ul class="mt-3 space-y-2">
        <li><a href="/guides/" class={linkClass}>All guides</a></li>
        <li><a href="/guides/eu-ai-act-uk/" class={linkClass}>EU AI Act and UK businesses</a></li>
        <li><a href="/guides/eu-ai-act-article-50-chatbots/" class={linkClass}>Article 50 and chatbots</a></li>
        <li><a href="/resources/ai-policy-template/" class={linkClass}>AI policy template</a></li>
      </ul>
    </div>
    <div>
      <p class="font-medium text-ink">Incubate Labs</p>
      <ul class="mt-3 space-y-2">
        <li><a href="/how-we-work/" class={linkClass}>How we work</a></li>
        <li><a href="/work/" class={linkClass}>Projects</a></li>
        <li><a href="/readiness-check/" class={linkClass}>Readiness Check</a></li>
        <li><a href="/about/" class={linkClass}>About</a></li>
        <li><a href="/contact/" class={linkClass}>Contact</a></li>
        <li><a href="/privacy/" class={linkClass}>Privacy</a></li>
      </ul>
    </div>
    <div>
      <p class="font-medium text-ink">Get in touch</p>
      <ul class="mt-3 space-y-2">
        <li><a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a></li>
        <li><a href={site.github} class={linkClass}>GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="max-w-page mx-auto px-4 sm:px-6 pb-10 text-xs text-muted">
    © {year} Incubate Labs. {site.legal}
  </div>
</footer>
