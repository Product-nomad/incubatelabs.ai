---
import Logo from "@/components/Logo.astro";

const links = [
  { href: "/use-cases/", label: "Where we can help" },
  { href: "/how-we-work/", label: "How we work" },
  { href: "/work/", label: "Projects" },
  { href: "/about/", label: "About" },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="border-b border-line">
  <div class="max-w-page mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" aria-label="Incubate Labs, home" class="shrink-0">
      <Logo height={36} />
    </a>

    <nav aria-label="Main" class="hidden md:flex items-center gap-7 text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class={`transition-colors hover:text-accent ${isActive(link.href) ? "text-ink font-medium" : "text-muted"}`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact/"
        aria-current={isActive("/contact/") ? "page" : undefined}
        class="bg-ink text-paper rounded-md px-4 py-2 font-medium transition-colors hover:bg-accent"
      >
        Get in touch
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="cursor-pointer rounded-md border border-line px-3 py-1.5 text-sm font-medium text-ink">
        Menu
      </summary>
      <nav
        aria-label="Main"
        class="absolute right-0 z-40 mt-2 w-60 rounded-xl border border-line bg-paper p-2 shadow-sm"
      >
        <ul class="text-sm">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class={`block rounded-md px-3 py-2 hover:bg-accent-soft ${isActive(link.href) ? "text-ink font-medium" : "text-muted"}`}
              >
                {link.label}
              </a>
            </li>
          ))}
          <li class="mt-1 border-t border-line pt-2">
            <a
              href="/contact/"
              aria-current={isActive("/contact/") ? "page" : undefined}
              class="block rounded-md bg-ink px-3 py-2 text-center font-medium text-paper hover:bg-accent"
            >
              Get in touch
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
