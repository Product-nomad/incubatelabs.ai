---
const links = [
  { href: "/", label: "Home" },
  { href: "/methodology/", label: "Methodology" },
  { href: "/services/", label: "Services" },
  { href: "/free/", label: "Free triage" },
  { href: "/contact/", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-neutral-200">
  <div class="max-w-page mx-auto px-6 py-5 flex items-center justify-between">
    <a href="/" class="font-bold text-lg tracking-tight">
      Incubate Labs
    </a>
    <nav>
      <ul class="flex gap-6 text-sm">
        {links.map((link) => {
          const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
          return (
            <li>
              <a
                href={link.href}
                class={`hover:text-accent transition-colors ${isActive ? "text-ink font-semibold" : "text-neutral-600"}`}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
