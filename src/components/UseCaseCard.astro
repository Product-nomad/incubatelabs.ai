---
import type { UseCase } from "@/data/useCases";

interface Props {
  useCase: UseCase;
  index: number;
}

const { useCase, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<a
  href={`/use-cases/${useCase.slug}/`}
  class="group flex flex-col border border-line rounded-xl p-6 transition-colors hover:border-accent"
>
  <span class="text-sm font-medium text-accent">{number}</span>
  <h3 class="mt-3 text-xl transition-colors group-hover:text-accent">{useCase.title}</h3>
  <p class="mt-2 text-muted">{useCase.card}</p>
  <span class="mt-auto pt-4 text-sm font-medium text-accent">Read more →</span>
</a>
