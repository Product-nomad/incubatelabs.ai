---
// "What we commit to": five numbered promises in the site's card style. Home (after the cost check)
// and /how-we-work/.
import PersonCheckIcon from "@/components/PersonCheckIcon.astro";
import { commitments, commitmentsIntro, PERSON_COMMITMENT } from "@/data/commitments";
---

<section id="commitments" class="max-w-page mx-auto px-4 sm:px-6 pb-20" aria-labelledby="commitments-heading">
  <h2 id="commitments-heading" class="text-3xl sm:text-4xl">What we commit to</h2>
  <p class="mt-4 max-w-prose text-lg text-muted">{commitmentsIntro}</p>
  <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {commitments.map((c, i) => (
      <li class="relative border border-line rounded-xl p-6">
        {i === PERSON_COMMITMENT && <span class="absolute right-5 top-4"><PersonCheckIcon /></span>}
        <span class="text-sm font-medium text-accent">{String(i + 1).padStart(2, "0")}</span>
        <p class="mt-3"><strong class="font-semibold">{c.lead}</strong> <span class="text-muted">{c.text}</span></p>
      </li>
    ))}
  </ol>
</section>
