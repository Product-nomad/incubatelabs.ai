---
// v1.1 spec §3: the hexagon mark. Decorative only.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" class="shrink-0"><polygon points="12,2 20.7,7 20.7,17 12,22 3.3,17 3.3,7" fill="#e8efe9" stroke="#1f5c45" stroke-width="2"/></svg>
