---
// "Websites that bring in work": full-width card after the six use-case cards, on the
// home page and /use-cases/. id="websites" so it can be linked to directly.
import Hexagon from "@/components/Hexagon.astro";

interface Props {
  // Match the use-case cards: h3 under a section h2 (home page), h2 under the page h1 (/use-cases/).
  headingLevel?: "h2" | "h3";
}

const { headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<a
  id="websites"
  href="/contact/"
  class="group flex scroll-mt-6 flex-col gap-4 border border-line rounded-xl p-6 transition-colors hover:border-accent [grid-column:1/-1] md:flex-row md:items-center md:gap-8"
>
  <div class="flex items-center gap-3 md:w-72 md:shrink-0">
    <Hexagon />
    <Heading class="text-xl transition-colors group-hover:text-accent">Websites that bring in work</Heading>
  </div>
  <p class="text-muted md:flex-1">A fast, clear site that explains what you do and turns visitors into enquiries. Built on its own or alongside an automation project, and connected to the systems behind it, so enquiries land where your team already works.</p>
  <span class="text-sm font-medium text-accent md:shrink-0">Talk about a website →</span>
</a>
