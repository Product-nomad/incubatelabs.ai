---
// "Websites that bring in work": full-width card after the six use-case cards, on the
// home page and /use-cases/. id="websites" so it can be linked to directly.
import Hexagon from "@/components/Hexagon.astro";
import AnimatedIllustration from "@/components/illustrations/AnimatedIllustration.astro";

interface Props {
  // Match the use-case cards: h3 under a section h2 (home page), h2 under the page h1 (/use-cases/).
  headingLevel?: "h2" | "h3";
}

const { headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<a
  id="websites"
  href="/contact/"
  data-anim-card
  class="group flex scroll-mt-6 flex-col overflow-hidden border border-line rounded-xl transition-colors hover:border-accent [grid-column:1/-1] md:flex-row"
>
  <!-- Art left and text right on desktop, stacked on mobile, as in the approved prototype. -->
  <AnimatedIllustration
    name="websites"
    class="bg-band border-b border-line px-4 py-[18px] md:flex md:basis-[58%] md:items-center md:border-b-0 md:border-r"
  />
  <div class="flex flex-1 flex-col justify-center gap-4 p-6">
    <div class="flex items-center gap-3">
      <Hexagon />
      <Heading class="text-xl transition-colors group-hover:text-accent">Websites that bring in work</Heading>
    </div>
    <p class="text-muted">A fast, clear site that explains what you do and turns visitors into enquiries. Built on its own or alongside an automation project, and connected to the systems behind it, so enquiries land where your team already works.</p>
    <span class="text-sm font-medium text-accent">Talk about a website →</span>
  </div>
</a>
